{
    "manifest_version": 3,
    "name": "Safari 번역 버튼",
    "description": "Safari 도구 막대에서 현재 페이지의 Apple 번역을 바로 실행합니다.",
    "version": "1.0.0",
    "icons": {
        "48": "images/icon-48.png",
        "96": "images/icon-96.png",
        "128": "images/icon-128.png",
        "256": "images/icon-256.png",
        "512": "images/icon-512.png"
    },
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "action": {
        "default_title": "이 페이지를 Apple 번역으로 번역",
        "default_icon": "images/toolbar-icon.svg"
    },
    "permissions": [
        "nativeMessaging"
    ]
}
